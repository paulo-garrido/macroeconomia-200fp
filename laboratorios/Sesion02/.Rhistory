22L,       "Jutiapa",          4L,         "Suroriente"
) %>%
mutate(clave_depto = normalizar_texto(departamento))
# 4. LOCALIZACIÓN DE ARCHIVOS --------------------------------------------------
archivo_pib_total <- buscar_archivo("5 PIB total por departamento")
