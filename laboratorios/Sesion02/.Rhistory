# ==============================================================================
# 01_construir_bd_maestra.R
# Base maestra departamental para investigaciones de convergencia,
# dependencia espacial y desigualdad económica territorial en Guatemala
#
# Cobertura objetivo: 22 departamentos, 2013-2024
# Fuentes principales:
#   5_PIB_total_por_departamento.xlsx
#   6_Resultados_por_departamento.xlsx
#   8_PIB_Per_Capita_por_departamento.xlsx
#   POBLACIÓN TOTAL DEPARTAMENTAL.xlsx
#
# Salidas:
#   Data_procesada/bd_departamental.csv
#   Data_procesada/bd_departamental.rds
#   Data_procesada/bd_sectorial.csv
#   Data_procesada/bd_sectorial.rds
#   Data_procesada/catalogo_departamentos.csv
#   Data_procesada/validaciones_bd.csv
#
# IMPORTANTE:
# - No modifica los Excel originales.
# - El PIB real se toma del total oficial en medidas encadenadas de volumen.
# - NO se reconstruye el PIB real sumando actividades, por la no aditividad
#   de los índices encadenados.
# ==============================================================================
# 0. PAQUETES ------------------------------------------------------------------
paquetes <- c(
"readxl",
"dplyr",
"tidyr",
"stringr",
"purrr",
"readr",
"tibble"
)
faltantes <- setdiff(paquetes, rownames(installed.packages()))
if (length(faltantes) > 0) {
stop(
paste0(
"Faltan los siguientes paquetes: ",
paste(faltantes, collapse = ", "),
".\nInstálelos con:\ninstall.packages(c(",
paste0('"', faltantes, '"', collapse = ", "),
"))"
)
)
}
library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(purrr)
library(readr)
library(tibble)
# 1. CONFIGURACIÓN -------------------------------------------------------------
# El script supone esta estructura:
#
# proyecto_pib_regional/
# ├── Data_original/
# │   ├── 5_PIB_total_por_departamento.xlsx
# │   ├── 6_Resultados_por_departamento.xlsx
# │   ├── 8_PIB_Per_Capita_por_departamento.xlsx
# │   └── POBLACIÓN TOTAL DEPARTAMENTAL.xlsx
# ├── Data_procesada/
# └── Scripts/
#     └── 01_construir_bd_maestra.R
#
# Si los Excel todavía están en la raíz del proyecto, el script también funciona.
DIR_ORIGINAL <- if (dir.exists("Data_original")) "Data_original" else "."
DIR_PROCESADA <- "Data_procesada"
dir.create(DIR_PROCESADA, showWarnings = FALSE, recursive = TRUE)
ANIO_INICIAL <- 2013L
ANIO_FINAL   <- 2024L
ANIOS        <- ANIO_INICIAL:ANIO_FINAL
# 2. FUNCIONES AUXILIARES ------------------------------------------------------
normalizar_texto <- function(x) {
x <- as.character(x)
x <- trimws(x)
x <- iconv(x, from = "", to = "ASCII//TRANSLIT")
x <- toupper(x)
x <- str_replace_all(x, "[^A-Z0-9]+", " ")
x <- str_squish(x)
x
}
buscar_archivo <- function(patron, directorio = DIR_ORIGINAL) {
archivos <- list.files(
directorio,
pattern = "\\.xlsx$",
full.names = TRUE,
ignore.case = TRUE
)
nombres_norm <- normalizar_texto(basename(archivos))
patron_norm  <- normalizar_texto(patron)
indice <- str_detect(nombres_norm, fixed(patron_norm))
if (sum(indice) == 0) {
stop(
paste0(
"No se encontró un archivo que coincida con: ", patron,
"\nDirectorio buscado: ", normalizePath(directorio, mustWork = FALSE)
)
)
}
if (sum(indice) > 1) {
stop(
paste0(
"Se encontraron varios archivos para el patrón: ", patron,
"\n", paste(basename(archivos[indice]), collapse = "\n")
)
)
}
archivos[indice]
}
obtener_columna <- function(df, patron) {
nombres_norm <- normalizar_texto(names(df))
patron_norm  <- normalizar_texto(patron)
idx <- which(str_detect(nombres_norm, fixed(patron_norm)))
if (length(idx) == 0) {
stop(
paste0(
"No fue posible identificar una columna que contenga: ", patron,
"\nColumnas disponibles:\n",
paste(names(df), collapse = " | ")
)
)
}
names(df)[idx[1]]
}
# 3. CATÁLOGO DE DEPARTAMENTOS -------------------------------------------------
